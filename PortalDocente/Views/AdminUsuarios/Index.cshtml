@model IReadOnlyList<UsuarioAdministracionItemViewModel>
@{
    ViewData["Title"] = "Gestión de usuarios";
}

<section class="page-heading">
    <div>
        <p class="eyebrow">ADMINISTRACIÓN</p>
        <h1>Gestión de usuarios</h1>
        <p class="page-subtitle">Crea cuentas, actualiza sus roles y administra su acceso al portal.</p>
    </div>
    <a class="button button-primary" asp-action="Crear">Crear usuario <span aria-hidden="true">+</span></a>
</section>

@if (TempData["Mensaje"] is string mensaje)
{
    <div class="admin-notice admin-notice-success" role="status">@mensaje</div>
}
@if (TempData["Error"] is string error)
{
    <div class="admin-notice admin-notice-error" role="alert">@error</div>
}

<section class="panel students-panel">
    @if (Model.Count == 0)
    {
        <div class="empty-state">
            <strong>No hay cuentas registradas.</strong>
            <p>Usa “Crear usuario” para agregar la primera cuenta.</p>
        </div>
    }
    else
    {
        <div class="table-scroll">
            <table class="data-table">
                <thead>
                    <tr>
                        <th scope="col">Usuario</th>
                        <th scope="col">Rol</th>
                        <th scope="col">Estado</th>
                        <th scope="col"><span class="visually-hidden">Acciones</span></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var usuario in Model)
                    {
                        <tr>
                            <td>
                                <strong>@usuario.NombreCompleto</strong>
                                <small class="table-secondary">@usuario.Correo</small>
                            </td>
                            <td>@usuario.Rol</td>
                            <td>
                                <span class="progress-status @(usuario.Activo ? "has-progress" : "no-progress")">
                                    <i aria-hidden="true"></i>@(usuario.Activo ? "Activo" : "Inactivo")
                                </span>
                            </td>
                            <td>
                                <div class="admin-user-actions">
                                    <a class="row-link" asp-action="Editar" asp-route-id="@usuario.Id">Editar</a>
                                    <form asp-action="Eliminar" asp-route-id="@usuario.Id" method="post"
                                          data-confirm-delete>
                                        @Html.AntiForgeryToken()
                                        <button class="admin-delete-button" type="submit">Eliminar</button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</section>
