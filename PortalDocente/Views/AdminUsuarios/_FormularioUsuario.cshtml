@* Parcial compartido para alta y edición: campos, rol, estado y cohortes disponibles del docente. *@
@model UsuarioAdministracionEditViewModel
@{
    var esCreacion = ViewData["EsCreacion"] is true;
}

<section class="panel admin-form-panel">
    <form asp-action="@(esCreacion ? "Crear" : "Editar")" asp-route-id="@(esCreacion ? null : Model.Id)"
          method="post" data-loading-message="@(esCreacion ? "Creando cuenta…" : "Guardando cambios…")"
          data-confirm-message="@(esCreacion ? string.Empty : "¿Guardar los cambios de esta cuenta y sus permisos?")">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="ModelOnly" class="validation-summary" role="alert"></div>
        <input asp-for="Id" type="hidden" />

        <div class="admin-form-grid">
            <div class="form-field">
                <label asp-for="NombreCompleto"></label>
                <input asp-for="NombreCompleto" class="portal-input" autocomplete="name"
                       placeholder="Ej. Ana Pérez" />
                <span asp-validation-for="NombreCompleto" class="field-error"></span>
            </div>
            <div class="form-field">
                <label asp-for="Correo"></label>
                <input asp-for="Correo" class="portal-input" autocomplete="email"
                       placeholder="nombre@ejemplo.edu" />
                <span asp-validation-for="Correo" class="field-error"></span>
            </div>
            <div class="form-field">
                <label asp-for="Rol"></label>
                <select asp-for="Rol" asp-items="ViewBag.Roles" class="portal-input">
                    <option value="">Selecciona un rol</option>
                </select>
                <span asp-validation-for="Rol" class="field-error"></span>
            </div>
            <div class="form-field">
                <label asp-for="Password">@(esCreacion ? "Contraseña inicial" : "Nueva contraseña (opcional)")</label>
                <input asp-for="Password" class="portal-input" autocomplete="new-password"
                       required="@esCreacion" />
                <span class="field-hint">Mínimo 12 caracteres. Nunca se muestra la contraseña actual.</span>
                <span asp-validation-for="Password" class="field-error"></span>
            </div>
            <div class="form-field">
                <label asp-for="CodigoInstitucional"></label>
                <input asp-for="CodigoInstitucional" class="portal-input" />
                <span class="field-hint">Opcional; se utiliza en cuentas de estudiante.</span>
                <span asp-validation-for="CodigoInstitucional" class="field-error"></span>
            </div>
            <div class="form-field">
                <label asp-for="TituloAcademico"></label>
                <input asp-for="TituloAcademico" class="portal-input" />
                <span class="field-hint">Opcional; se utiliza en cuentas de docente.</span>
                <span asp-validation-for="TituloAcademico" class="field-error"></span>
            </div>
            <label class="admin-active-option">
                <input asp-for="Activo" />
                <span>Cuenta activa</span>
            </label>
            <div class="admin-cohort-assignment" data-cohort-assignment>
                <h2>Cohortes compartidas</h2>
                <p class="field-hint">Selecciona las cohortes que este docente podrá consultar. El docente asignado originalmente conservará su acceso.</p>
                @if (Model.CohortesDisponibles.Count == 0)
                {
                    <p class="field-hint">No hay cohortes de otros docentes disponibles para compartir.</p>
                }
                else
                {
                    <div class="admin-cohort-options">
                        @foreach (var cohorte in Model.CohortesDisponibles)
                        {
                            <label class="admin-cohort-option">
                                <input type="checkbox" name="CohortesSeleccionadas"
                                       value="@cohorte.Id"
                                       checked="@(Model.CohortesSeleccionadas.Contains(cohorte.Id))" />
                                <span>
                                    <strong>@cohorte.NombreCurso</strong> (@cohorte.PeriodoAcademico)
                                    · @cohorte.NombreCohorte
                                    <small>Docente: @cohorte.NombreDocente</small>
                                </span>
                            </label>
                        }
                    </div>
                }
            </div>
        </div>

        <div class="admin-form-actions">
            <a class="button button-secondary" asp-action="Index">Cancelar</a>
            <button class="button button-primary" type="submit">@(esCreacion ? "Crear cuenta" : "Guardar cambios")</button>
        </div>
    </form>
</section>

@* El script solo oculta o muestra cohortes según el rol; la validación real ocurre en el servidor. *@
<script>
    (() => {
        const rol = document.getElementById("Rol");
        const asignacion = document.querySelector("[data-cohort-assignment]");
        if (!rol || !asignacion) return;

        const actualizarVisibilidad = () => {
            const esDocente = rol.value === "docente";
            asignacion.hidden = !esDocente;
            asignacion.querySelectorAll("input[type=checkbox]")
                .forEach(checkbox => checkbox.disabled = !esDocente);
        };

        rol.addEventListener("change", actualizarVisibilidad);
        actualizarVisibilidad();
    })();
</script>
