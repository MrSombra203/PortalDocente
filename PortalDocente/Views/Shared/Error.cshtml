@model ErrorViewModel
@{
    ViewData["Title"] = "Error";
}

<section class="page-heading">
    <div>
        <p class="eyebrow">PORTAL DOCENTE</p>
        <h1>No se pudo completar la solicitud</h1>
        <p class="page-subtitle">Inténtalo de nuevo. Si el problema continúa, contacta al equipo del proyecto.</p>
    </div>
</section>

@if (Model.ShowRequestId)
{
    <p class="page-subtitle">Código de seguimiento: <code>@Model.RequestId</code></p>
}
