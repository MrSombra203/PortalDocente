@{
    var controller = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    var action = ViewContext.RouteData.Values["action"]?.ToString() ?? "";
    var esAdministrador = User.Identity?.IsAuthenticated == true
                          && User.IsInRole(ClaimsPrincipalExtensions.RolAdmin);
    var esDocente = User.Identity?.IsAuthenticated == true
                    && User.IsInRole(ClaimsPrincipalExtensions.RolDocente);
    var mostrarNavegacion = esAdministrador || esDocente;
    var busquedaActual = Context.Request.Query["q"].ToString();
    var esLogin = string.Equals(controller, "Account", StringComparison.OrdinalIgnoreCase)
                  && string.Equals(action, "Login", StringComparison.OrdinalIgnoreCase);
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] · Portal Docente UDLA</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="@(mostrarNavegacion && !esLogin ? "app-shell" : "auth-shell")">
@if (mostrarNavegacion && !esLogin)
{
    <aside class="sidebar" id="sidebar">
        <div class="sidebar-brand">
            <span class="brand-mark" aria-hidden="true">U</span>
            <span><strong>UDLA</strong><small>PORTAL DOCENTE</small></span>
        </div>

        @if (esDocente)
        {
            <div class="sidebar-section">
                <span class="sidebar-label">SEGUIMIENTO</span>
                <a class="sidebar-link @(controller == "Home" ? "active" : null)"
                   aria-current="@(controller == "Home" && action == "Index" ? "page" : null)"
                   asp-controller="Home" asp-action="Index">
                    <span class="sidebar-ico" aria-hidden="true">▦</span> Resumen
                </a>
                <a class="sidebar-link @(controller == "Estudiantes" ? "active" : null)"
                   aria-current="@(controller == "Estudiantes" && action == "Index" ? "page" : null)"
                   asp-controller="Estudiantes" asp-action="Index">
                    <span class="sidebar-ico" aria-hidden="true">♙</span> Estudiantes
                </a>
            </div>
        }
        else
        {
            <div class="sidebar-section">
                <span class="sidebar-label">ADMINISTRACIÓN</span>
                <a class="sidebar-link @(controller == "AdminUsuarios" ? "active" : null)"
                   aria-current="@(controller == "AdminUsuarios" && action == "Index" ? "page" : null)"
                   asp-controller="AdminUsuarios" asp-action="Index">
                    <span class="sidebar-ico" aria-hidden="true">♙</span> Usuarios
                </a>
            </div>
        }

        <div class="sidebar-foot">
            <span class="status-dot"></span>
            <span>@(esDocente ? "Vista de seguimiento" : "Gestión de cuentas")<br />
                <small>@(esDocente ? "Solo lectura" : "Administración")</small></span>
        </div>
    </aside>

    <div class="main-wrap">
        <header class="topbar">
            <button type="button" class="menu-btn" id="sidebarToggle" aria-label="Abrir menú"
                    aria-controls="sidebar" aria-expanded="false">☰</button>
            @if (esDocente)
            {
                <form class="top-search" asp-controller="Estudiantes" asp-action="Index" method="get" role="search">
                    <label class="visually-hidden" for="top-search-input">Buscar estudiante</label>
                    <span aria-hidden="true">⌕</span>
                    <input id="top-search-input" type="search" name="q" value="@busquedaActual"
                           placeholder="Buscar estudiante…" />
                    <button type="submit">Buscar</button>
                </form>
            }
            <div class="topbar-right">
                <div class="user-chip">
                    <span class="avatar">@((User.Identity?.Name is { Length: > 0 } n) ? char.ToUpperInvariant(n[0]).ToString() : "D")</span>
                    <span>
                        <strong>@User.Identity?.Name</strong>
                        <small>@(esAdministrador ? "Administrador" : "Docente")</small>
                    </span>
                </div>
                <form asp-controller="Account" asp-action="Logout" method="post">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn-logout">Salir</button>
                </form>
            </div>
        </header>

        <main class="content-area">
            @RenderBody()
        </main>
    </div>
}
else
{
    <main class="auth-main">
        @RenderBody()
    </main>
}

    <div class="page-loader" id="pageLoader" role="status" aria-live="polite" aria-atomic="true" hidden>
        <span class="visually-hidden">Cargando, espera un momento.</span>
        <div class="page-loader-graphic" aria-hidden="true">
            <svg viewBox="0 0 800 500" xmlns="http://www.w3.org/2000/svg">
                <defs>
                    <linearGradient id="loaderChipGradient" x1="0" y1="0" x2="0" y2="1">
                        <stop offset="0%" stop-color="#40336b"></stop>
                        <stop offset="100%" stop-color="#251c40"></stop>
                    </linearGradient>
                    <linearGradient id="loaderTextGradient" x1="0" y1="0" x2="0" y2="1">
                        <stop offset="0%" stop-color="#fff"></stop>
                        <stop offset="100%" stop-color="#c8bfdf"></stop>
                    </linearGradient>
                    <linearGradient id="loaderPinGradient" x1="1" y1="0" x2="0" y2="0">
                        <stop offset="0%" stop-color="#d7d1e6"></stop>
                        <stop offset="50%" stop-color="#aaa1c1"></stop>
                        <stop offset="100%" stop-color="#766d8c"></stop>
                    </linearGradient>
                </defs>

                <g class="loader-traces">
                    <path d="M100 100 H200 V210 H326" class="loader-trace-bg"></path>
                    <path d="M100 100 H200 V210 H326" class="loader-trace-flow loader-purple"></path>
                    <path d="M80 180 H180 V230 H326" class="loader-trace-bg"></path>
                    <path d="M80 180 H180 V230 H326" class="loader-trace-flow loader-blue"></path>
                    <path d="M60 260 H150 V250 H326" class="loader-trace-bg"></path>
                    <path d="M60 260 H150 V250 H326" class="loader-trace-flow loader-gold"></path>
                    <path d="M100 350 H200 V270 H326" class="loader-trace-bg"></path>
                    <path d="M100 350 H200 V270 H326" class="loader-trace-flow loader-green"></path>
                    <path d="M700 90 H560 V210 H474" class="loader-trace-bg"></path>
                    <path d="M700 90 H560 V210 H474" class="loader-trace-flow loader-blue"></path>
                    <path d="M740 160 H580 V230 H474" class="loader-trace-bg"></path>
                    <path d="M740 160 H580 V230 H474" class="loader-trace-flow loader-green"></path>
                    <path d="M720 250 H590 V250 H474" class="loader-trace-bg"></path>
                    <path d="M720 250 H590 V250 H474" class="loader-trace-flow loader-purple"></path>
                    <path d="M680 340 H570 V270 H474" class="loader-trace-bg"></path>
                    <path d="M680 340 H570 V270 H474" class="loader-trace-flow loader-gold"></path>
                </g>

                <rect x="330" y="190" width="140" height="100" rx="20" ry="20"
                      fill="url(#loaderChipGradient)" stroke="#5942a6" stroke-width="3"
                      class="loader-chip"></rect>

                <g class="loader-pins">
                    <rect x="322" y="205" width="8" height="10" fill="url(#loaderPinGradient)" rx="2"></rect>
                    <rect x="322" y="225" width="8" height="10" fill="url(#loaderPinGradient)" rx="2"></rect>
                    <rect x="322" y="245" width="8" height="10" fill="url(#loaderPinGradient)" rx="2"></rect>
                    <rect x="322" y="265" width="8" height="10" fill="url(#loaderPinGradient)" rx="2"></rect>
                    <rect x="470" y="205" width="8" height="10" fill="url(#loaderPinGradient)" rx="2"></rect>
                    <rect x="470" y="225" width="8" height="10" fill="url(#loaderPinGradient)" rx="2"></rect>
                    <rect x="470" y="245" width="8" height="10" fill="url(#loaderPinGradient)" rx="2"></rect>
                    <rect x="470" y="265" width="8" height="10" fill="url(#loaderPinGradient)" rx="2"></rect>
                </g>

                <text x="400" y="240" font-family="Arial, sans-serif" font-size="22"
                      fill="url(#loaderTextGradient)" text-anchor="middle" dominant-baseline="middle"
                      class="loader-chip-text">CARGANDO</text>

                <g class="loader-nodes">
                    <circle cx="100" cy="100" r="5"></circle>
                    <circle cx="80" cy="180" r="5"></circle>
                    <circle cx="60" cy="260" r="5"></circle>
                    <circle cx="100" cy="350" r="5"></circle>
                    <circle cx="700" cy="90" r="5"></circle>
                    <circle cx="740" cy="160" r="5"></circle>
                    <circle cx="720" cy="250" r="5"></circle>
                    <circle cx="680" cy="340" r="5"></circle>
                </g>
            </svg>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
