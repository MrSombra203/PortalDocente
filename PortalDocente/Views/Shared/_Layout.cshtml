@{
    var controller = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    var action = ViewContext.RouteData.Values["action"]?.ToString() ?? "";
    var esAdministrador = User.Identity?.IsAuthenticated == true
                          && User.IsInRole(ClaimsPrincipalExtensions.RolAdmin);
    var esDocente = User.Identity?.IsAuthenticated == true
                    && User.IsInRole(ClaimsPrincipalExtensions.RolDocente);
    var mostrarNavegacion = esAdministrador || esDocente;
    var busquedaActual = Context.Request.Query["q"].ToString();
    var esLogin = string.Equals(controller, "Account", StringComparison.OrdinalIgnoreCase)
                  && string.Equals(action, "Login", StringComparison.OrdinalIgnoreCase);
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] · Portal Docente UDLA</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="@(mostrarNavegacion && !esLogin ? "app-shell" : "auth-shell")">
@if (mostrarNavegacion && !esLogin)
{
    <aside class="sidebar" id="sidebar">
        <div class="sidebar-brand">
            <span class="brand-mark">
                <img class="brand-logo" src="~/images/udla-logo.png" alt="Logotipo de la Universidad de Las Américas" />
            </span>
            <span><strong>UDLA</strong><small>PORTAL DOCENTE</small></span>
        </div>

        @if (esDocente)
        {
            <div class="sidebar-section">
                <span class="sidebar-label">SEGUIMIENTO</span>
                <a class="sidebar-link @(controller == "Home" ? "active" : null)"
                   data-loading-message="Cargando resumen…"
                   aria-current="@(controller == "Home" && action == "Index" ? "page" : null)"
                   asp-controller="Home" asp-action="Index">
                    <span class="sidebar-ico" aria-hidden="true">▦</span> Resumen
                </a>
                <a class="sidebar-link @(controller == "Estudiantes" ? "active" : null)"
                   data-loading-message="Cargando estudiantes…"
                   aria-current="@(controller == "Estudiantes" && action == "Index" ? "page" : null)"
                   asp-controller="Estudiantes" asp-action="Index">
                    <span class="sidebar-ico" aria-hidden="true">♙</span> Estudiantes
                </a>
            </div>
        }
        else
        {
            <div class="sidebar-section">
                <span class="sidebar-label">ADMINISTRACIÓN</span>
                <a class="sidebar-link @(controller == "AdminUsuarios" ? "active" : null)"
                   data-loading-message="Cargando usuarios…"
                   aria-current="@(controller == "AdminUsuarios" && action == "Index" ? "page" : null)"
                   asp-controller="AdminUsuarios" asp-action="Index">
                    <span class="sidebar-ico" aria-hidden="true">♙</span> Usuarios
                </a>
            </div>
        }

        <div class="sidebar-foot">
            <span class="status-dot"></span>
            <span>@(esDocente ? "Vista de seguimiento" : "Gestión de cuentas")<br />
                <small>@(esDocente ? "Solo lectura" : "Administración")</small></span>
        </div>
    </aside>

    <div class="main-wrap">
        <header class="topbar">
            <button type="button" class="menu-btn" id="sidebarToggle" aria-label="Abrir menú"
                    aria-controls="sidebar" aria-expanded="false">☰</button>
            @if (esDocente)
            {
                <form class="top-search searchbar" asp-controller="Estudiantes" asp-action="Index" method="get"
                      role="search" data-loading-message="Buscando estudiantes…">
                    <label class="visually-hidden" for="top-search-input">Buscar estudiante</label>
                    <input id="top-search-input" class="top-search-input" type="search" name="q" value="@busquedaActual"
                           placeholder="Buscar estudiante..." />
                    <span class="top-search-icon" aria-hidden="true">
                        <svg width="19" height="19" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                            <path d="M14 5H20M14 8H17" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
                            <path d="M21 11.5C21 16.75 16.75 21 11.5 21S2 16.75 2 11.5 6.25 2 11.5 2" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" />
                            <path d="m22 22-2-2" stroke="currentColor" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round" />
                        </svg>
                    </span>
                </form>
            }
            <div class="topbar-right">
                <div class="user-chip">
                    <span class="avatar">@((User.Identity?.Name is { Length: > 0 } n) ? char.ToUpperInvariant(n[0]).ToString() : "D")</span>
                    <span>
                        <strong>@User.Identity?.Name</strong>
                        <small>@(esAdministrador ? "Administrador" : "Docente")</small>
                    </span>
                </div>
                <form asp-controller="Account" asp-action="Logout" method="post"
                      data-loading-message="Cerrando sesión…">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn-logout">Salir</button>
                </form>
            </div>
        </header>

        <main class="content-area">
            @RenderBody()
        </main>
    </div>
}
else
{
    <main class="auth-main">
        @RenderBody()
    </main>
}

    <div class="page-loader" id="pageLoader" role="status" aria-live="polite"
         aria-atomic="true" aria-label="Cargando información" hidden>
        <div class="page-loader-content">
            <span class="visually-hidden" data-loading-announcement>Cargando información…</span>
            <div class="ghost-loader" aria-hidden="true">
                <div class="ghost-loader-body">
                    <span class="ghost-loader-pupil ghost-loader-pupil--left"></span>
                    <span class="ghost-loader-pupil ghost-loader-pupil--right"></span>
                    <span class="ghost-loader-eye ghost-loader-eye--left"></span>
                    <span class="ghost-loader-eye ghost-loader-eye--right"></span>
                    <span class="ghost-loader-piece ghost-loader-piece--top0"></span>
                    <span class="ghost-loader-piece ghost-loader-piece--top1"></span>
                    <span class="ghost-loader-piece ghost-loader-piece--top2"></span>
                    <span class="ghost-loader-piece ghost-loader-piece--top3"></span>
                    <span class="ghost-loader-piece ghost-loader-piece--top4"></span>
                    <span class="ghost-loader-piece ghost-loader-piece--st0"></span>
                    <span class="ghost-loader-piece ghost-loader-piece--st1"></span>
                    <span class="ghost-loader-piece ghost-loader-piece--st2"></span>
                    <span class="ghost-loader-piece ghost-loader-piece--st3"></span>
                    <span class="ghost-loader-piece ghost-loader-piece--st4"></span>
                    <span class="ghost-loader-piece ghost-loader-piece--st5"></span>
                    <span class="ghost-loader-piece ghost-loader-piece--an1"></span>
                    <span class="ghost-loader-piece ghost-loader-piece--an2"></span>
                    <span class="ghost-loader-piece ghost-loader-piece--an3"></span>
                    <span class="ghost-loader-piece ghost-loader-piece--an4"></span>
                    <span class="ghost-loader-piece ghost-loader-piece--an5"></span>
                    <span class="ghost-loader-piece ghost-loader-piece--an6"></span>
                    <span class="ghost-loader-piece ghost-loader-piece--an7"></span>
                    <span class="ghost-loader-piece ghost-loader-piece--an8"></span>
                    <span class="ghost-loader-piece ghost-loader-piece--an9"></span>
                    <span class="ghost-loader-piece ghost-loader-piece--an10"></span>
                    <span class="ghost-loader-piece ghost-loader-piece--an11"></span>
                    <span class="ghost-loader-piece ghost-loader-piece--an12"></span>
                    <span class="ghost-loader-piece ghost-loader-piece--an13"></span>
                    <span class="ghost-loader-piece ghost-loader-piece--an14"></span>
                    <span class="ghost-loader-piece ghost-loader-piece--an15"></span>
                    <span class="ghost-loader-piece ghost-loader-piece--an16"></span>
                    <span class="ghost-loader-piece ghost-loader-piece--an17"></span>
                    <span class="ghost-loader-piece ghost-loader-piece--an18"></span>
                </div>
                <span class="ghost-loader-shadow"></span>
            </div>
            <span class="page-loader-message" data-loading-message aria-hidden="true">Cargando información…</span>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
