@{
    var controller = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    var action = ViewContext.RouteData.Values["action"]?.ToString() ?? "";
    var autenticado = User.Identity?.IsAuthenticated == true && User.IsInRole("docente");
    var esLogin = string.Equals(controller, "Account", StringComparison.OrdinalIgnoreCase)
                  && string.Equals(action, "Login", StringComparison.OrdinalIgnoreCase);
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] · Portal Docente UDLA</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="@(autenticado && !esLogin ? "app-shell" : "auth-shell")">
@if (autenticado && !esLogin)
{
    <aside class="sidebar" id="sidebar">
        <div class="sidebar-brand">
            <span class="brand-mark" aria-hidden="true">U</span>
            <span><strong>UDLA</strong><small>PORTAL DOCENTE</small></span>
        </div>

        <div class="sidebar-section">
            <span class="sidebar-label">SEGUIMIENTO</span>
            <a class="sidebar-link @(controller == "Home" ? "active" : null)"
               asp-controller="Home" asp-action="Index">
                <span class="sidebar-ico" aria-hidden="true">▦</span> Resumen
            </a>
            <a class="sidebar-link @(controller == "Estudiantes" ? "active" : null)"
               asp-controller="Estudiantes" asp-action="Index">
                <span class="sidebar-ico" aria-hidden="true">♙</span> Estudiantes
            </a>
        </div>

        <div class="sidebar-foot">
            <span class="status-dot"></span>
            <span>Vista de seguimiento<br /><small>Solo lectura</small></span>
        </div>
    </aside>

    <div class="main-wrap">
        <header class="topbar">
            <button type="button" class="menu-btn" id="sidebarToggle" aria-label="Abrir menú" aria-expanded="false">☰</button>
            <form class="top-search" asp-controller="Estudiantes" asp-action="Index" method="get" role="search">
                <label class="visually-hidden" for="top-search-input">Buscar estudiante</label>
                <span aria-hidden="true">⌕</span>
                <input id="top-search-input" type="search" name="q" placeholder="Buscar estudiante…" />
                <button type="submit">Buscar</button>
            </form>
            <div class="topbar-right">
                <div class="user-chip">
                    <span class="avatar">@((User.Identity?.Name is { Length: > 0 } n) ? char.ToUpperInvariant(n[0]).ToString() : "D")</span>
                    <span>
                        <strong>@User.Identity?.Name</strong>
                        <small>Docente</small>
                    </span>
                </div>
                <form asp-controller="Account" asp-action="Logout" method="post">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn-logout">Salir</button>
                </form>
            </div>
        </header>

        <main class="content-area">
            @RenderBody()
        </main>
    </div>
}
else
{
    <main class="auth-main">
        @RenderBody()
    </main>
}

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
