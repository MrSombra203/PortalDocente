@model IReadOnlyList<EvolucionPuntoViewModel>
@{
    var valores = Model.Select(punto => punto.Puntuacion).ToList();
    var maximo = Math.Max(100m, valores.Max());
    var puntos = string.Join(" ", valores.Select((valor, indice) =>
        string.Join(",", (valores.Count == 1 ? 300m : 30m + (540m * indice / (valores.Count - 1)))
            .ToString("0.##", System.Globalization.CultureInfo.InvariantCulture),
            (160m - (valor / maximo * 130m)).ToString("0.##", System.Globalization.CultureInfo.InvariantCulture))));
}

<div class="chart-wrap">
    <div class="chart-scale">
        <span>@maximo.ToString("0.#")</span>
        <span>@((maximo / 2m).ToString("0.#"))</span>
        <span>0</span>
    </div>
    <svg class="line-chart" viewBox="0 0 600 180" role="img" aria-label="Evolución de puntuaciones">
        <line x1="30" y1="30" x2="570" y2="30" class="chart-gridline" />
        <line x1="30" y1="95" x2="570" y2="95" class="chart-gridline" />
        <line x1="30" y1="160" x2="570" y2="160" class="chart-gridline" />
        @if (valores.Count > 1)
        {
            <polyline points="@puntos" class="chart-line" />
        }
        @foreach (var (punto, indice) in Model.Select((punto, indice) => (punto, indice)))
        {
            var x = valores.Count == 1 ? 300 : 30 + (540m * indice / (valores.Count - 1));
            var y = 160m - (punto.Puntuacion / maximo * 130m);
            <circle cx="@x.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)"
                    cy="@y.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)"
                    r="4" class="chart-dot">
                <title>@punto.Etiqueta: @punto.Puntuacion.ToString("0.0") puntos</title>
            </circle>
        }
    </svg>
</div>
<div class="chart-labels">
    @foreach (var punto in Model)
    {
        <span>@punto.Etiqueta</span>
    }
</div>
