@{
    ViewData["Title"] = "Privacidad";
}

<section class="page-heading">
    <div>
        <p class="eyebrow">PORTAL DOCENTE</p>
        <h1>@ViewData["Title"]</h1>
        <p class="page-subtitle">Información sobre el uso de este portal.</p>
    </div>
</section>

<section class="panel privacy-panel">
    <h2>Uso de la información</h2>
    <p>
        El portal utiliza una cuenta docente para controlar el acceso y muestra información académica
        de las cohortes asignadas, consultada desde la base de datos del sistema.
    </p>
    <p>
        Está diseñado para consultar el progreso y los resultados de los estudiantes. No permite
        administrar ni modificar los registros académicos.
    </p>
</section>
