@model LoginViewModel
@{
    ViewData["Title"] = "Iniciar sesión";
}

<div class="login-page">
    <section class="login-illustration" aria-label="Portal Docente UDLA">
        <div class="login-brand">
            <span class="brand-mark" aria-hidden="true">U</span>
            <span><strong>UDLA</strong><small>PORTAL DOCENTE</small></span>
        </div>
        <div class="login-message">
            <p class="eyebrow">SEGUIMIENTO ACADÉMICO</p>
            <h1>El progreso de tus estudiantes, en un solo lugar.</h1>
            <p>Consulta el avance, los resultados y el historial de partidas de tus cohortes.</p>
        </div>
        <div class="login-illustration-footer">Gestión Inteligente · El Arte de la Logística</div>
    </section>
    <section class="login-form-side">
        <div class="login-form-card">
            <p class="eyebrow">BIENVENIDO/A</p>
            <h2>Iniciar sesión</h2>
            <p class="page-subtitle">Ingresa con tu cuenta docente para continuar.</p>

            @if (!string.IsNullOrWhiteSpace(Model.MensajeDemo))
            {
                <div class="notice notice-demo login-demo" role="note">
                    <span class="notice-mark" aria-hidden="true">i</span>
                    <span>@Model.MensajeDemo</span>
                </div>
            }

            <form asp-controller="Account" asp-action="Login" method="post" class="login-form">
                @Html.AntiForgeryToken()
                <input type="hidden" name="returnUrl" value="@Context.Request.Query["returnUrl"]" />
                <div asp-validation-summary="ModelOnly" class="validation-summary" role="alert"></div>
                <div class="form-field">
                    <label asp-for="Correo"></label>
                    <input asp-for="Correo" autocomplete="username" placeholder="nombre@udla.edu.ec" />
                    <span asp-validation-for="Correo" class="field-error"></span>
                </div>
                <div class="form-field">
                    <label asp-for="Password"></label>
                    <input asp-for="Password" autocomplete="current-password" placeholder="Tu contraseña" />
                    <span asp-validation-for="Password" class="field-error"></span>
                </div>
                <button class="button button-primary login-submit" type="submit">Entrar al portal <span aria-hidden="true">→</span></button>
            </form>
            <p class="login-footnote">Acceso exclusivo para docentes.</p>
        </div>
    </section>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
